<isset name="isunifiedCheckoutEnabled" value="${require('*/cartridge/configuration/index').unifiedCheckoutEnabled}" scope="page" />
<isset name="isTokenationEnabled" value="${require('*/cartridge/configuration/index').tokenizationEnabled}" scope="page" />
<isset name="isCartridgeEnabled" value="${require('*/cartridge/configuration/index').cartridgeEnabled}" scope="page" />

<iscomment>
    My Account card saving is Unified Checkout (UC) only. The UC widget
    collects the card + billing details and posts the completeMandate JWT to
    PaymentInstruments-SavePaymentDirect. The SecureAcceptance-CreateUCTokenSaveCard endpoint
    is gated only on the cartridge being enabled, so the save-card widget loads in every case;
    The legacy Flex microform / plain card-entry form has been removed from My Account.
</iscomment>

<isif condition="${isCartridgeEnabled && isTokenationEnabled && isunifiedCheckoutEnabled}">
    <iscomment>UC v1 Save Card Mode - Widget collects everything</iscomment>

    <iscomment>Include UC widget and scripts</iscomment>
    <isinclude url="${URLUtils.url('SecureAcceptance-CreateUCTokenSaveCard')}" />

    <iscomment>Hidden form for CSRF token and UC response data</iscomment>
    <form id="uc-save-payment-form" class="payment-form uc-save-card-form" method="POST"
        action="${URLUtils.url('PaymentInstruments-SavePaymentDirect')}"
        data-save-payment-direct-url="${URLUtils.https('PaymentInstruments-SavePaymentDirect')}"
        data-payment-instruments-list-url="${URLUtils.url('PaymentInstruments-List')}">

        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
        <input type="hidden" name="completeMandateJwt" id="completeMandateJwt" value="" />
        <input type="hidden" name="transientToken" id="transientToken" value="" />
        <iscomment>
            Reload endpoint for the "Reload and try again" link shown when a save fails.
            Re-fetches a fresh UC widget + capture context so the shopper can retry
            without a full page reload (which would clear the error message).
        </iscomment>
        <input type="hidden" id="uc-save-card-reload-url" value="${URLUtils.https('SecureAcceptance-CreateUCTokenSaveCard')}" />

        <div class="make-default-payment">
            <div class="form-group custom-control custom-checkbox">
                <input type="checkbox" class="custom-control-input" id="makeDefaultPayment" name="makeDefaultPayment">
                <label class="custom-control-label" for="makeDefaultPayment">
                    ${Resource.msg('label.payment.checkbox.makedefault', 'payment', null)}
                </label>
            </div>
        </div>

        <iscomment>Cancel and Save Buttons</iscomment>
        <div class="row uc-save-card-buttons">
            <div class="col">
                <a href="${URLUtils.url('PaymentInstruments-List')}" class="btn btn-block btn-outline-primary">${Resource.msg('button.cancel', 'account', null)}</a>
            </div>
        </div>
    </form>
<iselse>
    <iscomment>
        Unified Checkout is not enabled. My Account card saving requires UC, so no
        card-entry form is shown here. Enable Unified Checkout in the cartridge
        configuration to allow shoppers to save cards from My Account.
    </iscomment>
    <div class="alert alert-info" role="alert">
        ${Resource.msg('msg.payment.uc.required', 'payment', 'Saving a card is currently unavailable. Please try again later.')}
    </div>
</isif>
