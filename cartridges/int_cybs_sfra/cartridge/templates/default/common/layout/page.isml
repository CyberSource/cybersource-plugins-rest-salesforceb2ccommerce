<iscontent type="text/html" charset="UTF-8" compact="true" />
<isinclude template="/components/modules" sf-toolkit="off" />

<iscomment>Add Unified Checkout JS globally for minicart support</iscomment>
<isset name="isUCEnabled" value="${require('*/cartridge/configuration/index').unifiedCheckoutEnabled}" scope="page" />
<isset name="isCartridgeEnabled" value="${require('*/cartridge/configuration/index').cartridgeEnabled}" scope="page" />
<isset name="isExpressPayEnabled" value="${require('*/cartridge/configuration/index').unifiedCheckoutExpressPay}" scope="page" />
<isif condition="${isCartridgeEnabled && isUCEnabled && isExpressPayEnabled}">
	<isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addJs('/custom/unifiedCheckout.js');
    </isscript>
</isif>

<!DOCTYPE html>
<html lang="${require('dw/util/Locale').getLocale(request.getLocale()).getLanguage()}">

<head>
	<!--[if gt IE 9]><!-->
	<isinclude sf-toolkit="off" template="/common/scripts" />
	<!--<![endif]-->
	<isinclude template="/common/htmlHead" />
	<isif condition="${pdict.canonicalUrl}">
		<link rel="canonical" href="${pdict.canonicalUrl}" />
	</isif>
	<isactivedatahead/>
	<isinclude template="/components/schema" />
</head>

<body>
	<div class="page" data-action="${pdict.action}" data-querystring="${pdict.queryString}">
		<isinclude template="/components/header/pageHeader" />
		<div role="main" id="maincontent">
			<isreplace/>
		</div>
		<isinclude template="/components/footer/pageFooter" />
	</div>
	<div class="error-messaging"></div>
	<div class="modal-background"></div>
	<iscontentasset aid="cookie_hint" />

	
	<input type="hidden" name="cartridgeEnabled" id="cartridgeEnabled" value="${require('*/cartridge/configuration/index').cartridgeEnabled}"/>

	<isinclude url="${URLUtils.url('ConsentTracking-Check')}" />
</body>

</html>
