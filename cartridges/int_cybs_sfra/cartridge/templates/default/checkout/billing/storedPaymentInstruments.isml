<isscript>
    // Gate the pre-checkout TMS refresh behind the VisaAcceptance_NetworkToken preference
    // (configObject.networkTokenizationEnabled). When disabled, render the saved-card
    // list exactly as before — no .cybs-saved-cards wrapper means the client refresh
    // module finds nothing to do and stays inert.
    var cybsConfig = require('*/cartridge/configuration/index');
    var networkTokenEnabled = cybsConfig.networkTokenizationEnabled;
</isscript>
<isif condition="${networkTokenEnabled}">
    <isscript>
        var CSRFProtection = require('dw/web/CSRFProtection');
        var URLUtils = require('dw/web/URLUtils');
        var csrfName = CSRFProtection.getTokenName();
        var csrfToken = CSRFProtection.generateToken();
    </isscript>
    <div class="cybs-saved-cards"
         data-refresh-url="${URLUtils.url('SavedCardRefresh-Refresh').toString()}"
         data-list-url="${URLUtils.url('SavedCardRefresh-List').toString()}"
         data-csrf-name="${csrfName}"
         data-csrf-token="${csrfToken}">
        <isinclude template="checkout/billing/storedPaymentInstrumentsList" />
    </div>
<iselse/>
    <isinclude template="checkout/billing/storedPaymentInstrumentsList" />
</isif>
