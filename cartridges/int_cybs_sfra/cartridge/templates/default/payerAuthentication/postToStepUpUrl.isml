<iscomment>
	TEMPLATENAME: postToStepUpUrl.isml

	Renders the payer authentication step-up page with modal.

	The iframe starts HIDDEN behind a spinner and is only revealed once a cross-origin load proves
	the ACS has put something on screen for the shopper. Once the challenge finishes, the spinner
	comes back and stays up through validation and the final top-level redirect.
</iscomment>
<iscontent type="text/html" charset="UTF-8" compact="true"/>
<link rel="stylesheet" href="${URLUtils.staticURL('/css/payerAuth.css')}"/>
<script src="${URLUtils.staticURL('/custom/lib/jquery/jquery-3.7.1.min.js')}"></script>
<script src="${URLUtils.staticURL('/js/payerAuthStepUp.js')}"></script>

<div id="cyb_payerauth_stepup" class="payerauth-stepup"
	 data-complete-message-type="${pdict.completeMessageType}">
	<input type="hidden" id="stepUpUrl" value="${pdict.stepUpUrl}"/>
	<input type="hidden" id="JWT" value="${pdict.jwtToken}"/>
	<input type="hidden" id="orderNo" value="${pdict.orderNo}"/>
</div>

<iscomment>Modal for Step-Up Authentication</iscomment>
<div id="stepup-modal-overlay" class="stepup-modal-overlay">
	<div class="stepup-modal-content">
		<h3 class="stepup-modal-title">${Resource.msg('payment.authentication.title', 'visaacceptance', 'Payment Authentication')}</h3>
		<div class="stepup-iframe-container">
			<iscomment>
				Shown while the ACS is being contacted and again for the whole post-challenge wait,
				so the shopper never faces a blank iframe or a stale checkout page.
			</iscomment>
			<div id="stepup-status" class="stepup-status">
				<div class="stepup-spinner"></div>
				<p id="stepup-status-message" class="stepup-status-message"
				   data-verifying-message="${Resource.msg('payment.authentication.verifying', 'visaacceptance', null)}"
				   data-timeout-message="${Resource.msg('payment.authentication.timeout', 'visaacceptance', null)}">
					${Resource.msg('payment.authentication.verifying', 'visaacceptance', null)}
				</p>
			</div>
			<iframe id="step-up-iframe" name="step-up-iframe" class="stepup-iframe stepup-iframe-hidden"></iframe>
			<form id="step-up-form" target="step-up-iframe" method="post" action="${pdict.stepUpUrl}" class="hidden">
				<input type="hidden" name="JWT" value="${pdict.jwtToken}"/>
				<isif condition="${pdict.isScaFlow}">
					<input type="hidden" name="MD" value="${pdict.orderNo},SCA"/>
				<iselse/>
					<input type="hidden" name="MD" value="${pdict.orderNo}"/>
				</isif>
			</form>
		</div>
	</div>
</div>
