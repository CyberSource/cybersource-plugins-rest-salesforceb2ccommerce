<iscontent type="text/html" charset="UTF-8" compact="true"/>
 
<isset name="isUCEnabled" value="${require('*/cartridge/configuration/index').unifiedCheckoutEnabled}" scope="page" />
<isset name="isCartridgeEnabled" value="${require('*/cartridge/configuration/index').cartridgeEnabled}" scope="page" />
<isset name="isExpressPayEnabled" value="${require('*/cartridge/configuration/index').unifiedCheckoutExpressPay}" scope="page" />
 <input type="hidden" id="minicart-submit-payment-url" value="${URLUtils.url('CheckoutServices-SubmitPayment')}" />
 <input type="hidden" id="minicart-place-order-url" value="${URLUtils.https('Checkout-Begin', 'stage', 'placeOrder')}" />
<isif condition="${isUCEnabled && isCartridgeEnabled && isExpressPayEnabled}">
    <iscomment>
        Do NOT load a second jQuery here. This template is injected into the minicart
        popover (miniCart.isml -> checkoutButtons -> here) and on the cart page. The SFRA
        bundle (main.js) already assigns window.$/window.jQuery globally on every page.
        Re-loading jQuery replaces that global instance AFTER SFRA's miniCart.js bound its
        count:update / product:afterAddToCart / cart:update listeners, so those events fire
        on a different instance and silently no-op (stale quantity badge + frozen minicart).
    </iscomment>
    <isinclude url="${URLUtils.url('SecureAcceptance-CreateUCTokenMiniCart')}" />
   
    <iscomment>Include Unified Checkout template</iscomment>
    <isinclude template="unifiedCheckout" />
</isif>
