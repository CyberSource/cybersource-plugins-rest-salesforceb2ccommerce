<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="VisaAcceptance_Secure_Integration_Method">
                <display-name xml:lang="x-default">Secure Integration Method</display-name>
                <description xml:lang="x-default">Selects the integration mode: Unified Checkout or Salesforce default card form.</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition default="true">
                        <display xml:lang="x-default">Unified Checkout</display>
                        <value>Unified_Checkout</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Salesforce Default Credit Card Payment Acceptance</display>
                        <value>Salesforce_Default</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_UnifiedCheckout_ExpressPay">
                <display-name xml:lang="x-default">Enable Express Pay</display-name>
                <description xml:lang="x-default">Enable Wallet/Express Payments on cart and minicart.</description>
                <type>boolean</type>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_UnifiedCheckout_CheckoutLabel">
                <display-name xml:lang="x-default">Checkout Label for Unified Checkout</display-name>
                <description xml:lang="x-default">Label for Unified Checkout Tab on the payment page</description>
                <type>string</type>
                <externally-managed-flag>false</externally-managed-flag>
                <regex>^.{0,60}$</regex>
                <default-value>Secure Payments powered by Visa Acceptance Solutions</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_UnifiedCheckout_ClientVersion">
                <display-name xml:lang="x-default">Checkout Version (optional)</display-name>
                <description xml:lang="x-default">Unified Checkout 1.x version. Leave blank for the latest release.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <regex>^$|^1(\.\d+)?$</regex>
                <default-value></default-value>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_UnifiedCheckout_AllowedCardPrefix">
                <display-name xml:lang="x-default">Card Prefix (BIN) in UC Response</display-name>
                <description xml:lang="x-default">Card prefix (BIN) length returned in the UC token response.</description>
                <type>enum-of-string</type>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Six-digit BIN</display>
                        <value>Six</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Eight-digit BIN</display>
                        <value>Eight</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="VisaAcceptance_UnifiedCheckout_NonWalletDisplayMode">
                <display-name xml:lang="x-default">Non-Wallet UC Display Mode</display-name>
                <description xml:lang="x-default">Display mode for the card / non-wallet UC instance.</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition default="true">
                        <display xml:lang="x-default">Embedded</display>
                        <value>Embedded</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Sidebar</display>
                        <value>Sidebar</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="VisaAcceptance_SecureIntegrationConfiguration">
                <display-name xml:lang="x-default">Secure Integration Configuration</display-name>
                <attribute attribute-id="VisaAcceptance_Secure_Integration_Method"/>
                <attribute attribute-id="VisaAcceptance_UnifiedCheckout_CheckoutLabel"/>
                <attribute attribute-id="VisaAcceptance_UnifiedCheckout_ExpressPay"/>
                <attribute attribute-id="VisaAcceptance_UnifiedCheckout_ClientVersion"/>
                <attribute attribute-id="VisaAcceptance_UnifiedCheckout_AllowedCardPrefix"/>
                <attribute attribute-id="VisaAcceptance_UnifiedCheckout_NonWalletDisplayMode"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>