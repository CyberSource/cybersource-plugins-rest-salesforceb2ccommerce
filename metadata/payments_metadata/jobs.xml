<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    
    <job job-id="Payment: Decision Manager Order Update" priority="0">
        <description>Update unconfirmed orders based on Accept / Reject decisions made in Business Center.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch"/>
            <step step-id="UpdateOrderStatus" type="ExecuteScriptModule" enforce-restart="false">
                <description>Update unconfirmed orders based on Accept / Reject decisions made in Business Center.</description>
                <parameters>
                    <parameter name="ExecuteScriptModule.Module">int_cybs_sfra_base/cartridge/scripts/jobs/DMOrderStatusUpdate.js</parameter>
                    <parameter name="ExecuteScriptModule.FunctionName">orderStatusUpdate</parameter>
                    <parameter name="ExecuteScriptModule.Transactional">false</parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="true">
                <recurrence>
                    <date-from>2020-08-04Z</date-from>
                    <start-time>01:43:49.000Z</start-time>
                    <interval>1h</interval>
                    <day-of-week/>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>

    <job job-id="Payment: Refresh Payment Status" priority="0">
        <description>On-demand: refresh Visa Acceptance payment status for the supplied order numbers and update the Visa Acceptance Transaction Status. Enter a comma-separated list of order numbers in the OrderNumbers parameter and use Run Now.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch"/>
            <step step-id="RefreshPaymentStatus" type="ExecuteScriptModule" enforce-restart="false">
                <description>Refresh payment status for the supplied order numbers.</description>
                <parameters>
                    <parameter name="ExecuteScriptModule.Module">int_cybs_sfra_base/cartridge/scripts/jobs/RefreshPaymentStatus.js</parameter>
                    <parameter name="ExecuteScriptModule.FunctionName">refreshOrders</parameter>
                    <parameter name="ExecuteScriptModule.Transactional">false</parameter>
                    <parameter name="OrderNumbers"></parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers/>
    </job>

</jobs>
